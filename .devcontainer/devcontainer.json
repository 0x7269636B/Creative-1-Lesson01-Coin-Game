{
  "name": "ROBOTONIO Pygame",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Pygame Web",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "python -m pip install --disable-pip-version-check -r requirements.txt",
  "customizations": {
    "vscode": {
      "settings": {
        "files.eol": "\n"
      }
    }
  }
}
